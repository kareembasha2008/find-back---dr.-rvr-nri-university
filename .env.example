# FIND BACK - Dr. RVR NRI University, Agiripalli
# Supabase Configuration

# ----------------------------------------------------
# Browser / Client Environment Variables (Vite)
# Safe to expose in the frontend bundle (subject to RLS)
# ----------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# ----------------------------------------------------
# Server-Side Only Secrets (DO NOT expose to frontend!)
# ----------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Gemini AI API Key for Campus AI Assistant & Maps Grounding
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Google Maps Platform API Key (Optional - campus coordinate map activates if empty)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Optional App URL
APP_URL="http://localhost:3000"
